# API base URL used by the frontend (defaults to http://localhost:4001/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Optional: alternate API base URL (http/https)
NEXT_PUBLIC_API_BASE_URL=

# Optional: realtime WebSocket URL (ws/wss)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws

# Optional: Stellar network — one of testnet, futurenet, mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional: Soroban pool contract ID (56 chars, starts with C)
NEXT_PUBLIC_POOL_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: Soroban policy contract ID (56 chars, starts with C)
NEXT_PUBLIC_POLICY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: JSON object of boolean feature-flag overrides, e.g. {"realtime-oracle":true}
NEXT_PUBLIC_FLAGS_OVERRIDE=

# Optional: enable the UI gallery — "true" or "false"
NEXT_PUBLIC_ENABLE_UI_GALLERY=false
