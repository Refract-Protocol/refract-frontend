# Environment variables for the Refract frontend.
# Validated at startup by src/lib/env.ts.
#
# Legend:
#   REQUIRED  — the app will throw at startup if this is absent or empty.
#   OPTIONAL  — has a default or is only needed for specific features.
#
# Copy this file to .env.local and fill in the values you need.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Default: http://localhost:4001/api/v1  (safe for local dev without this set)
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# WebSocket URL for the realtime service.
# Default: derived from NEXT_PUBLIC_API_URL (replace http with ws, strip /api/v1).
# Set this if the realtime and REST services run on different hosts.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws

# Stellar network to connect to: "testnet" or "mainnet".
# Default: "testnet"
# NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban contract IDs. Required only when you use the pool / policy features.
# NEXT_PUBLIC_POOL_CONTRACT_ID=
# NEXT_PUBLIC_POLICY_CONTRACT_ID=

# REST base URL override. Only needed if the REST base differs from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_API_BASE_URL=

# JSON object to force-enable or force-disable feature flags locally.
# Example: {"realtime-oracle":true,"new-claim-flow":false}
# NEXT_PUBLIC_FLAGS_OVERRIDE={"realtime-oracle":true}

# Set to "true" to show the internal UI component gallery at /dev/ui.
# NEXT_PUBLIC_ENABLE_UI_GALLERY=false
