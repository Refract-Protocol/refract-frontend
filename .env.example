# Environment variables read by src/lib/env.ts.
# Copy to .env.local and fill in the values you need.
#
# REQUIRED: app crashes on startup if unset (no default).
#   (none — all variables below have defaults or are truly optional)
#
# OPTIONAL WITH DEFAULT: safe to omit; a sensible default is used.
# NEXT_PUBLIC_API_URL — base URL for the REST API.
#   Default: http://localhost:4001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# OPTIONAL (feature-specific): only needed for the named feature.

# Alternative base URL for API requests (overrides NEXT_PUBLIC_API_URL).
# Only needed when the API and app are served from different origins.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4001

# WebSocket endpoint for the realtime transport (realtime-oracle / realtime-pool features).
# Derived from NEXT_PUBLIC_API_URL if unset.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws

# Stellar network to target. Accepts: testnet, futurenet, mainnet.
# Default: testnet
# NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban contract IDs (56 chars, starts with C). Required for pool/policy features.
# NEXT_PUBLIC_POOL_CONTRACT_ID=
# NEXT_PUBLIC_POLICY_CONTRACT_ID=

# JSON object of feature-flag overrides, e.g. {"realtime-oracle":true}.
# Overrides the server-side flag service for local development.
# NEXT_PUBLIC_FLAGS_OVERRIDE={"realtime-oracle":true}

# Set to "true" to enable the internal UI component gallery route.
# Default: false
# NEXT_PUBLIC_ENABLE_UI_GALLERY=false
