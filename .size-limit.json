[
  {
    "name": "shared JS (all routes, excluding lazy realtime chunk)",
    "path": [".next/static/chunks/*.js", "!.next/static/chunks/realtime*.js"],
    "limit": "250 kB",
    "gzip": true
  },
  {
    "name": "app router runtime",
    "path": ".next/static/chunks/app/layout-*.js",
    "limit": "120 kB",
    "gzip": true
  },
  {
    "name": "home route",
    "path": ".next/static/chunks/app/page-*.js",
    "limit": "80 kB",
    "gzip": true
  },
  {
    "name": "all route chunks",
    "path": ".next/static/chunks/app/**/*.js",
    "limit": "400 kB",
    "gzip": true
  },
  {
    "name": "realtime client (lazy chunk)",
    "path": ".next/static/chunks/realtime*.js",
    "limit": "8 kB",
    "gzip": true
  }
]
