{
  "name": "prompt-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:msw": "NEXT_PUBLIC_API_MOCKING=enabled next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit": "audit-ci --config audit-ci.json",
    "prepare": "husky",
    "analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.0",
    "framer-motion": "^11.0.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^19",
    "zod": "^4.6.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.5",
    "@size-limit/file": "^11.1.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^19",
    "audit-ci": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "husky": "^9.1.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "^15.2.7",
    "msw": "2.3.1",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "size-limit": "^11.1.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "size-limit": [
    {
      "name": "Shared JS (all routes)",
      "path": ".next/static/chunks/*.js",
      "limit": "250 kB",
      "gzip": true
    },
    {
      "name": "App Router per-page chunks",
      "path": ".next/static/chunks/app/**/*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}
