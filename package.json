{
  "name": "refract-protocol-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "framer-motion": "^11.0.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.5",
    "@size-limit/file": "^11.1.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "size-limit": "^11.1.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "size-limit": [
    {
      "name": "Shared JS (all routes)",
      "path": ".next/static/chunks/*.js",
      "limit": "250 kB",
      "gzip": true
    },
    {
      "name": "App Router per-page chunks",
      "path": ".next/static/chunks/app/**/*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}
