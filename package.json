{
  "name": "prompt-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:msw": "NEXT_PUBLIC_API_MOCKING=enabled next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "test:chaos": "vitest run --config vitest.config.mts src/lib/realtime/__tests__/chaos.test.ts src/lib/realtime/__tests__/transportParity.test.ts",
    "test:chaos:e2e": "NEXT_PUBLIC_ENABLE_UI_GALLERY=true playwright test e2e/realtime-chaos.spec.ts --project=chromium",
    "mock:realtime": "node scripts/mock-realtime-server.mjs",
    "bench:realtime": "npx --yes tsx scripts/realtime-decode-bench.mts",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "audit": "audit-ci --config audit-ci.json",
    "prepare": "husky",
    "analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "size:realtime": "node scripts/check-realtime-bundle.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "gen:realtime-types": "node scripts/gen-realtime-types.mjs",
    "check:realtime-types": "node scripts/gen-realtime-types.mjs --check",
    "realtime:benchmark": "node scripts/realtime-benchmark.mjs",
    "canary:realtime": "tsx scripts/realtime-canary.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "11.8.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.0",
    "@walletconnect/sign-client": "^2.26.0",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "framer-motion": "^11.0.0",
    "next": "14.2.35",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.5",
    "@playwright/test": "^1.45.0",
    "@size-limit/file": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "audit-ci": "^7.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.4",
    "jest": "30.5.2",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "^24.1.1",
    "lint-staged": "^17.6.0",
    "msw": "2.3.1",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "size-limit": "^11.1.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^7",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
